{
  "name": "@mijohen/storybook-preset-aurelia2-webpack",
  "version": "0.0.2",
  "description": "Storybook Aurelia 2 preset",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mijohen/storybook-aurelia2"
  },
  "dependencies": {
    "@storybook/core-webpack": "^8.0.0"
  },
  "devDependencies": {
    "@aurelia/webpack-loader": "2.0.0-beta.12",
    "aurelia": "2.0.0-beta.12",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "@aurelia/webpack-loader": "2.0.0-beta.12",
    "aurelia": "2.0.0-beta.12"
  },
  "scripts": {
    "prep": "node --loader ../../scripts/node_modules/esbuild-register/loader.js -r ../../scripts/node_modules/esbuild-register/register.js ../../scripts/prepare/bundle.ts"
  },
  "bundler": {
    "entries": [
      "./src/index.ts"
    ],
    "platform": "node"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
